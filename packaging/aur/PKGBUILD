# Maintainer: PurpleDefender249 <PurpleDefender249@users.noreply.github.com>
pkgname=beebox
pkgver=0.1.0
pkgrel=1
pkgdesc="Flight recorder that explains why your Linux computer crashed, froze or lost power"
arch=('x86_64' 'aarch64')
url="https://github.com/PurpleDefender249/beebox"
license=('MIT')
depends=('systemd')
makedepends=('go')
optdepends=('libnotify: desktop notification after a crash'
            'smartmontools: disk health checks suggested in reports')
backup=('etc/beebox/beebox.conf')
install=beebox.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # run updpkgsums after publishing the release

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0 GOTOOLCHAIN=local
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  make build man completions VERSION="$pkgver" COMMIT=aur
}

check() {
  cd "$pkgname-$pkgver"
  GOTOOLCHAIN=local go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr VERSION="$pkgver" COMMIT=aur
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
